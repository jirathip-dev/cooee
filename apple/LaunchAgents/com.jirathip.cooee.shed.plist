<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- #142: the Mac app's login item (SMAppService.agent), running the shed binary inside the app bundle. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jirathip.cooee.shed</string>
	<key>BundleProgram</key>
	<string>Contents/Helpers/shed</string>
	<key>ProgramArguments</key>
	<array>
		<string>shed</string>
		<string>serve</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<string>com.jirathip.cooee</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>
