[
  { "name": "screen", "note": "large title, toolbar actions, a live stream",
    "block": { "type": "screen", "id": "lanes", "title": "Lanes", "stream": "/screens/lanes/stream",
      "actions": [ { "icon": "plus", "label": "New lane", "tap": { "sheet": "/screens/lanes/new" } } ],
      "blocks": [ { "type": "text", "markdown": "3 lanes on **mini**." } ] } },
  { "name": "section", "note": "a header, blocks, a footer",
    "block": { "type": "section", "header": "machines", "footer": "Seen once a minute.",
      "blocks": [ { "type": "list", "rows": [ { "type": "row", "title": "mini", "value": "online" } ] } ] } },
  { "name": "list + row", "note": "title, subtitle, badge, figure, value, accessory, swipe, tap",
    "block": { "type": "list", "id": "lanes", "rows": [
      { "type": "row", "id": "l-722", "figure": { "state": "working", "tool": "run" }, "title": "#722 spawn (shed)",
        "subtitle": "cargo test -p herdsman-core", "badge": { "text": "impl", "tone": "working" },
        "value": { "since": "2026-11-09T09:32:00Z" }, "tap": { "open": "/screens/lane?n=722" },
        "swipe": [ { "label": "Stop", "tone": "bad", "action": "stop" } ] },
      { "type": "row", "id": "l-708", "figure": { "state": "done" }, "title": "#708 doctor: bound every call",
        "badge": { "text": "ready", "tone": "done" }, "accessory": "chevron", "tap": { "thread": "herdsman-impl-708" } } ] } },
  { "name": "card", "note": "a titled group with a tone, a badge, buttons",
    "block": { "type": "card", "id": "fleet", "tone": "accent", "title": "herdsman", "badge": { "text": "driving", "tone": "ok" },
      "subtitle": "7 lanes on mini",
      "buttons": [ { "type": "button", "label": "Drive now", "style": "primary", "action": "drive" } ],
      "blocks": [ { "type": "text", "markdown": "Next pass in 3 min." } ] } },
  { "name": "choice", "note": "options, the recommended first, an other box, a default",
    "block": { "type": "choice", "id": "q947", "action": "answer", "question": "Move the branch out?", "recommended": "move",
      "options": [ { "value": "refuse", "label": "refuse" }, { "value": "move", "label": "move it out" } ],
      "other": { "placeholder": "other…" },
      "default": { "value": "move", "until": "2026-11-09T09:53:00Z", "label": "takes the recommendation in {rel}" } } },
  { "name": "form", "note": "text, toggle, picker, secret; values go back by name",
    "block": { "type": "form", "id": "f", "submit": { "label": "Save", "action": "save" }, "fields": [
      { "type": "text", "name": "branch", "label": "Branch", "value": "staging" },
      { "type": "toggle", "name": "drive", "label": "Drive", "value": true },
      { "type": "picker", "name": "host", "label": "Host", "value": "mini", "options": ["mini", "air"] },
      { "type": "secret", "name": "GH_TOKEN", "label": "GH_TOKEN", "set": true } ] } },
  { "name": "button", "note": "primary, plain or destructive",
    "block": { "type": "button", "id": "wave", "label": "Wave", "style": "primary", "action": "wave", "values": { "to": "all" } } },
  { "name": "button.confirm", "note": "drawn by the client, never by the plugin",
    "block": { "type": "confirm", "title": "Remove cooee-drover?", "message": "Its queue and lanes stay on disk.", "ok": "Remove", "destructive": true } },
  { "name": "chips", "note": "filters: one or many selected",
    "block": { "type": "chips", "id": "repo", "name": "repo", "multi": false, "selected": ["herdsman"], "action": "filter",
      "options": [ { "value": "all", "label": "all" }, { "value": "cooee", "label": "cooee" }, { "value": "herdsman", "label": "herdsman" } ] } },
  { "name": "stat + sparkline", "note": "one tile, or a row of them",
    "block": { "type": "stat", "id": "s", "items": [
      { "label": "merged · 7d", "value": "14", "spark": [1, 3, 2, 0, 4, 1, 3] },
      { "label": "lanes", "value": "7", "unit": "/ 8", "tone": "warn" } ] } },
  { "name": "text", "note": "markdown: paragraphs, **bold**, `code`, fences, links; {rel} ticks",
    "block": { "type": "text", "markdown": "Run **once** on mini:\n\n```\ngit push origin --delete wip/x\n```\n\nlapses in {rel}", "until": "2026-11-09T09:52:00Z" } },
  { "name": "images", "note": "gap 1: added, a row of pictures that open full screen",
    "block": { "type": "images", "id": "pngs", "items": [
      { "src": "/files/125/queue-390-light.png", "alt": "Queue" }, { "src": "/files/125/asks-390-dark.png", "alt": "Asks" },
      { "src": "/files/125/hello-390-light.png", "alt": "hello" } ] } },
  { "name": "sheet", "note": "a screen that slides up: Cancel, the title, its done action",
    "block": { "type": "sheet", "id": "new-fleet", "title": "New fleet", "cancel": "Cancel", "done": { "label": "Add", "action": "add-fleet" },
      "blocks": [ { "type": "form", "id": "nf", "fields": [ { "type": "text", "name": "repo", "label": "Repo", "placeholder": "owner/name" } ] } ] } },
  { "name": "web", "note": "the escape hatch: a sandboxed frame on the plugin's backend",
    "block": { "type": "web", "id": "chart", "src": "/web/load-24h.html", "height": 120 } }
]
